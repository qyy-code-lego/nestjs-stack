# 应用
PORT=2400
APP_NAME=qyy-code-lego-app

# ---------- 应用日志 ----------
# 控制台日志级别：fatal | error | warn | info | debug | verbose（默认 info）
APP_LOG_LEVEL=info
# 日志上下文名称，缺省取 APP_NAME
# APP_LOGGER_CONTEXT=qyy-code-lego-app

# ---------- 请求日志 ----------
# 访问日志输出到 stdout（access log），默认 false
APP_REQUEST_LOGS_ACCESS_LOG_ENABLED=false
# 请求日志持久化落库，默认 false
APP_REQUEST_LOGS_PERSIST_ENABLED=false

# ---------- 日志文件落盘（异步滚动，默认关闭，开启后控制台仍原样输出）----------
# 总开关；关闭时对 std 输出零侵入
APP_LOG_FILE_ENABLED=false
# 落盘格式：json（结构化逐行，推荐）| text（原样镜像 std，剥离 ANSI）
APP_LOG_FILE_FORMAT=json
# 落盘目录（相对 cwd 或绝对），docker 部署建议 /app/logs
APP_LOG_FILE_DIR=./logs
# 文件名模板，占位符 {app}/{pid}/{host}
APP_LOG_FILE_NAME={app}.log
# 按大小翻转阈值，留空则不按大小翻转
APP_LOG_FILE_MAX_SIZE=20M
# 按时间翻转间隔（1d/12h/30m），留空则不按时间翻转
APP_LOG_FILE_INTERVAL=1d
# 历史归档保留份数，留空不限制
APP_LOG_FILE_MAX_FILES=14
# 翻转归档是否 gzip
APP_LOG_FILE_COMPRESS=true
# 仅 json：额外捕获进程级崩溃（uncaughtException/unhandledRejection）
APP_LOG_FILE_CAPTURE_STD=false

# ---------- 健康检查（HealthModule，默认开启）----------
# 总开关，false 时 /health 接口返回 404
APP_HEALTH_ENABLED=true
# readiness 详情令牌：非空则 /health/ready 需 X-Health-Token 头或 ?token= 匹配；留空交由 nginx IP 限制
# APP_HEALTH_TOKEN=
# readiness 结果缓存（毫秒），抗高频探测/防雪崩
APP_HEALTH_CACHE_TTL_MS=3000
# 单个检查硬超时（毫秒），卡死查询只判 down 不拖垮接口
APP_HEALTH_CHECK_TIMEOUT_MS=2500

#数据库
DATABASE_USER=nestjs_boilerplate
DATABASE_PASSWORD=nestjs_boilerplate
DATABASE_NAME=nestjs_boilerplate
DATABASE_PORT=15432
DATABASE_HOST=127.0.0.1


# jwt
JWT_SECRET=nestjs-app-jwt-secret

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 注意redis缓存prefix分割
REDIS_KEY_PREFIX=qyy-code-lego-app:
# REDIS_PASSWORD=

# Kafka Config
KAFKA_CLIENT_ID=qyy-code-lego-app-kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=qyy-code-lego-app-group
# Kafka Consumer 会话超时时间（毫秒），默认 30000ms (30秒)
# 设置为较小值可以更快检测 consumer 故障并触发 rebalance
# 注意：太小的值可能导致频繁的 rebalance，建议最小值不低于 6000ms
KAFKA_SESSION_TIMEOUT=6000
# Kafka Consumer 心跳间隔时间（毫秒），默认 3000ms (3秒)
# 必须小于 sessionTimeout，建议设置为 sessionTimeout 的 1/3
KAFKA_HEARTBEAT_INTERVAL=2000
# Kafka Rebalance 超时时间（毫秒），默认 60000ms (60秒)
KAFKA_REBALANCE_TIMEOUT=60000

# RabbitMQ Config
RABBIT_URLS=amqp://localhost:5672
RABBIT_QUEUE=qyy-code-lego-app-queue