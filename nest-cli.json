{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/khy/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/khy/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/khy",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "entities": {
      "type": "library",
      "root": "libs/entities",
      "entryFile": "index",
      "sourceRoot": "libs/entities/src",
      "compilerOptions": {
        "tsConfigPath": "libs/entities/tsconfig.lib.json"
      }
    },
    "web": {
      "type": "library",
      "root": "libs/web",
      "entryFile": "index",
      "sourceRoot": "libs/web/src",
      "compilerOptions": {
        "tsConfigPath": "libs/web/tsconfig.lib.json"
      }
    },
    "khy": {
      "type": "application",
      "root": "apps/khy",
      "entryFile": "main",
      "sourceRoot": "apps/khy/src",
      "compilerOptions": {
        "tsConfigPath": "apps/khy/tsconfig.app.json"
      }
    },
    "playground": {
      "type": "application",
      "root": "apps/playground",
      "entryFile": "main",
      "sourceRoot": "apps/playground/src",
      "compilerOptions": {
        "tsConfigPath": "apps/playground/tsconfig.app.json"
      }
    },
    "qyy-code-lego-app": {
      "type": "application",
      "root": "apps/qyy-code-lego-app",
      "entryFile": "main",
      "sourceRoot": "apps/qyy-code-lego-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/qyy-code-lego-app/tsconfig.app.json"
      }
    },
    "ykl": {
      "type": "application",
      "root": "apps/ykl",
      "entryFile": "main",
      "sourceRoot": "apps/ykl/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ykl/tsconfig.app.json"
      }
    },
    "yypt": {
      "type": "application",
      "root": "apps/yypt",
      "entryFile": "main",
      "sourceRoot": "apps/yypt/src",
      "compilerOptions": {
        "tsConfigPath": "apps/yypt/tsconfig.app.json"
      }
    }
  }
}
