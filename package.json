{
  "name": "@qyy-code-lego/nestjs",
  "version": "0.0.1",
  "description": "qyy-code-lego NestJS Boilerplate & Shared Libraries",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "peerDependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.1",
    "bullmq": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.0"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:play && npm run build:app",
    "build:web": "tsc -p libs/web/tsconfig.lib.json",
    "build:play": "nest build playground --webpack",
    "build:app": "nest build qyy-code-lego-app --webpack",
    "dev:play": "nest start playground --watch --debug 9232",
    "dev:app": "nest start qyy-code-lego-app --watch --debug 9233",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/playground/test/jest-e2e.json",
    "skills:list": "node skills/bin/install-skills.mjs --list",
    "skills:install": "node skills/bin/install-skills.mjs",
    "skills:validate": "node skills/bin/validate-skills.mjs"
  },

  "postinstall": "patch-package",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1030.0",
    "@aws-sdk/s3-request-presigner": "3.1030.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bullmq": "^5.67.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "dayjs": "^1.11.19",
    "fs-extra": "^11.3.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "multer": "^2.0.2",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^3.2.6",
    "rxjs": "^7.8.2",
    "snowflakify": "^1.0.6",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "run-script-webpack-plugin": "^0.2.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "webpack": "^5.106.2",
    "webpack-node-externals": "^3.0.0",
    "patch-package": "^8.0.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": "."
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@qyy-code-lego/nestjs/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@qyy-code-lego/nestjs/core(|/.*)$": "<rootDir>/libs/core/src/$1",
      "^@qyy-code-lego/nestjs/entities(|/.*)$": "<rootDir>/libs/entities/src/$1"
    }
  }
}
